{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/05-TOOLS/session-workspace-notice.sh",
            "timeout": 10,
            "statusMessage": "Checking where this session is working"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/05-TOOLS/guard-workspace-delete.py",
            "timeout": 10,
            "statusMessage": "Checking the delete is scoped to one work item"
          }
        ]
      },
      {
        "matcher": "Bash|Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/05-TOOLS/guard-readonly-clone.py",
            "timeout": 10,
            "statusMessage": "Checking the write is in a workspace, not a clone"
          }
        ]
      }
    ]
  }
}
